# Environment selection: dev | qa | stage | prod
ENV=qa

# Base URL for the selected environment (overrides environment config when set)
# BASE_URL=

# Browser selection: chromium | firefox | webkit
BROWSER=chromium

# Headless mode (true/false)
HEADLESS=true

# Application credentials — NEVER commit real values.
# The bundled self-contained demo (demo/login.html) accepts demo/password.
USERNAME=demo
PASSWORD=password

# Jira integration (optional)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
