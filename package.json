{
  "name": "tomato-agentic-qa",
  "version": "1.0.0",
  "description": "Production-ready Playwright + TypeScript + Cucumber BDD automation framework with Allure reporting, multi-environment support, and Cline AI agents.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "demo": "node scripts/demo-server.js",
    "test": "cucumber-js",
    "test:smoke": "cucumber-js --tags @smoke",
    "test:regression": "cucumber-js --tags @regression",
    "test:sanity": "cucumber-js --tags @sanity",
    "test:critical": "cucumber-js --tags @critical",
    "test:headed": "cucumber-js --world-parameters '{\"headed\":true}'",
    "test:debug": "DEBUG=pw:api cucumber-js",
    "test:chromium": "cucumber-js --world-parameters '{\"browser\":\"chromium\"}'",
    "test:firefox": "cucumber-js --world-parameters '{\"browser\":\"firefox\"}'",
    "test:webkit": "cucumber-js --world-parameters '{\"browser\":\"webkit\"}'",
    "report:allure": "allure generate reports/allure-results --clean -o reports/allure-report && allure open reports/allure-report",
    "report:cucumber": "echo 'Cucumber HTML/JSON reports are generated during the run at reports/cucumber-report/'",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@faker-js/faker": "^9.4.0",
    "allure-js-commons": "^3.12.2",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "allure-commandline": "^2.32.0",
    "allure-cucumberjs": "^3.12.2",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
